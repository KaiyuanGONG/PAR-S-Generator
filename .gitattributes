* text=auto

*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.csv text eol=lf -whitespace
*.svg text eol=lf -whitespace
*.qss text eol=lf
*.ps1 text eol=lf
*.smc text eol=lf -whitespace
*.mhd text eol=lf
*.res text eol=lf -whitespace
*.hct text eol=lf -whitespace

# Preserve the exact bytes of frozen Stage-3 CSV evidence that predates the
# repository-wide LF rule; this prevents line-ending-only worktree changes.
runs/stage3-phantom-100-v3-20260818/figures/phantom_distribution_data.csv -text
runs/stage3-phantom-100-v3-20260818/figures/projection_qc_data.csv -text
runs/stage3-simind-pilot-10-v3-20260818/figures/phantom_distribution_data.csv -text
runs/stage3-simind-pilot-10-v3-20260818/figures/projection_qc_data.csv -text

# The legacy checksum inventory is itself a byte-level LF freeze.  An explicit
# checkout EOL keeps its SHA256 stable even on CRLF worktrees.
manifests/legacy-v1-weighted-mc/file_inventory.sha256 text eol=lf

# Vite output includes third-party shader source strings whose intentional
# spacing must not fail repository whitespace checks.
webui/frontend/dist/** -whitespace

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.spe binary
